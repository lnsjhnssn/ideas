---
import Layout from "../layouts/Layout.astro";
import ShaderStars from "../components/ShaderStars.jsx";
import BlurBackground from "../components/BlurBackground.astro";
import ShaderPixels from "../components/ShaderPixels.jsx";
import DriftingLights from "../components/DriftingLights.jsx";
---

<Layout>
  <section class="blur-background">
    <BlurBackground />
  </section>
  <ShaderStars client:load />
  <section class="shader-pixels"><ShaderPixels client:load /></section>
  <section class="drifting-lights"><DriftingLights client:load /></section>
</Layout>

<style>
  .blur-background {
    height: 100vh;
  }
  .shader-pixels {
    height: 100vh;
  }
</style>
